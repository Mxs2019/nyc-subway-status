# GTFS Static feed URL (default: MTA supplemented subway feed)
# GTFS_STATIC_URL=https://rrgtfsfeeds.s3.amazonaws.com/gtfs_supplemented.zip

# GTFS-RT TripUpdates feed URLs (comma-separated, optional override)
# GTFS_RT_TRIPUPDATES_URLS=

# GTFS-RT Alerts feed URL (optional)
# GTFS_RT_ALERTS_URL=https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/camsys%2Fall-alerts

# Site URL for metadata/sitemap
# NEXT_PUBLIC_SITE_URL=https://nyc-subway-status.com
